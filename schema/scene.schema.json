{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mascot Motion scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "width", "height", "layers", "animations"],
  "properties": {
    "version": { "const": 1 },
    "width": { "type": "number", "exclusiveMinimum": 0 },
    "height": { "type": "number", "exclusiveMinimum": 0 },
    "perspective": { "type": "number", "exclusiveMinimum": 0 },
    "label": { "type": "string" },
    "debug": { "type": "boolean" },
    "autoplay": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/animation" }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "src": { "type": "string", "minLength": 1 },
        "parent": { "type": ["string", "null"] },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "fit": { "enum": ["contain", "cover", "fill"] },
        "origin": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "zIndex": { "type": "number" },
        "alt": { "type": "string" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration", "tracks"],
      "properties": {
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "loop": { "type": "boolean" },
        "easing": {
          "enum": ["linear", "easeInOut", "easeOutCubic", "backOut", "spring"]
        },
        "tracks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/keyframe" }
          }
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at"],
      "properties": {
        "at": { "type": "number", "minimum": 0, "maximum": 1 },
        "easing": {
          "enum": ["linear", "easeInOut", "easeOutCubic", "backOut", "spring"]
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "rotateX": { "type": "number" },
        "rotateY": { "type": "number" },
        "rotateZ": { "type": "number" },
        "scaleX": { "type": "number" },
        "scaleY": { "type": "number" },
        "scaleZ": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
